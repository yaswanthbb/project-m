{
  "name": "daily-drop-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo/metro-runtime": "~58.0.14",
    "@expo/ui": "~58.0.18",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/messaging": "^26.4.0",
    "expo": "~58.0.11",
    "expo-constants": "~58.0.12",
    "expo-dev-client": "~58.0.13",
    "expo-font": "~58.0.8",
    "expo-linking": "~58.0.13",
    "expo-notifications": "~58.1.4",
    "expo-router": "~58.0.20",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.9",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "expo-updates": "~58.0.17",
    "lucide-react-native": "^1.57.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "preview": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "vitest run tests --exclude tests/browser/**",
    "export:android": "expo export --platform android --output-dir artifacts/android",
    "export:preview": "expo export --platform web",
    "format": "prettier --write src index.ts app.config.ts tests scripts eas.json playwright.config.mjs",
    "preview:serve": "node scripts/serve-preview.mjs",
    "test:ui": "playwright test",
    "preview:phone": "expo start --go"
  },
  "private": true,
  "overrides": {
    "@grpc/grpc-js": "^1.13.6",
    "react-native-worklets": "0.13.0",
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
