DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
PUBLISH_TOKEN=replace-with-a-long-random-secret
# Set one of these; leave both empty to save content with queued pushes.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Browser origins allowed to use the static PWA. No paths or trailing slashes.
# Default * allows public cross-origin access, without cookie credentials.
FRONTEND_ORIGINS=*
